# Discord OAuth Configuration
# Get these from https://discord.com/developers/applications

# Public variables (client-side) - use NEXT_PUBLIC_ prefix
NEXT_PUBLIC_DISCORD_CLIENT_ID=your_client_id_here
NEXT_PUBLIC_DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# Secret variables (server-side only) - NO prefix
DISCORD_CLIENT_SECRET=your_client_secret_here

# For Vercel production deployment:
# NEXT_PUBLIC_DISCORD_REDIRECT_URI=https://your-vercel-domain.vercel.app/api/auth/discord/callback
